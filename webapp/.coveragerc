[run]
omit =
    venv/*
    */venv/*
    tests/*
    */tests/*
    alembic/*
    */alembic/*
    scripts/*
    */scripts/*
    __pycache__/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

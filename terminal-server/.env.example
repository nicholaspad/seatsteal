# All environment variables match webapp/config.py as the source of truth

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# GitHub (for EC2 deployment scripts)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxx

# AWS (for EC2 operations and SES email)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_SES_FROM_EMAIL=notifications@seatsteal.app

# Frontend URL (for notification links)
FRONTEND_URL=https://seatsteal.app

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15551234567

# CORS allowed origins (comma-separated, or * for all)
ALLOWED_ORIGINS=https://seatsteal.vercel.app,https://your-custom-domain.com

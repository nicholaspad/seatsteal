# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AWS SES (Email Notifications)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_SES_FROM_EMAIL=notifications@seatsteal.com

# Application
NODE_ENV=development
PYTHON_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Scraper Configuration
SCRAPER_CONCURRENT_LIMIT=5
SCRAPER_RATE_LIMIT=100

# Frontend-specific (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}
VITE_API_BASE_URL=${API_BASE_URL}